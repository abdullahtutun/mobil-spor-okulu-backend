# /etc/mso-backup.env olarak kopyalayın (chmod 600, sahibi root).
# Gerçek değerler yalnızca sunucuda; bu dosya repoda yer tutucudur.

# İkinci lokasyondaki S3 uyumlu depo (yurt içi). Biçim:
#   s3:https://<uç nokta>/<bucket>/mso
RESTIC_REPOSITORY=s3:https://S3-UC-NOKTASI/BUCKET/mso
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bazı yurt içi sağlayıcılar bölge ister
# AWS_DEFAULT_REGION=

# Coolify'daki Postgres konteynerinin adı (docker ps --format '{{.Names}}')
DB_CONTAINER=
# API'nin /data/storage volume'unun sunucudaki yolu
# (docker volume inspect <ad> --format '{{.Mountpoint}}')
STORAGE_PATH=/var/lib/docker/volumes/VOLUME-ADI/_data

# Saklama: gün / hafta / ay
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Uptime Kuma "Push" ya da healthchecks.io adresi; boş = ping yok
BACKUP_PING_URL=

# Aylık geri yükleme testinin ping adresi (ayrı monitör); boş = ping yok
RESTORE_PING_URL=
# Geri yükleme testinin kullandığı Postgres imajı (docs/ops/deploy.md)
PG_IMAGE=mobil-spor-okulu-postgres:17
