# /etc/mso-backup.env olarak kopyalayın (chmod 600, sahibi root).
# Gerçek değerler yalnızca sunucuda; bu dosya repoda yer tutucudur.

# Bugün: sunucudaki yerel depo — sunucu kaybını KARŞILAMAZ.
RESTIC_REPOSITORY=/var/backups/mso-restic
# Sonraki iyileştirme: ikinci lokasyonda S3 uyumlu depo (yurt içi). Biçim:
#   RESTIC_REPOSITORY=s3:https://<uç nokta>/<bucket>/mso  (+ AWS_* aşağıda)
RESTIC_PASSWORD=
# systemd HOME vermez; önbellek yoksa restic her çalıştırmada uyarır ve yavaşlar
RESTIC_CACHE_DIR=/root/.cache/restic
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bazı yurt içi sağlayıcılar bölge ister
# AWS_DEFAULT_REGION=

# Coolify'daki Postgres konteynerinin adı (docker ps --format '{{.Names}}')
DB_CONTAINER=
# API'nin /data/storage volume'unun sunucudaki yolu
# (docker volume inspect <ad> --format '{{.Mountpoint}}')
STORAGE_PATH=/var/lib/docker/volumes/VOLUME-ADI/_data

# Saklama: bu süreden eski yedek kalmaz (restic --keep-within; gizlilik
# metni §9 "en fazla 30 gün" ile aynı — birini değiştiren ikisini değiştirir)
KEEP_WITHIN=30d

# Uptime Kuma "Push" ya da healthchecks.io adresi; boş = ping yok
BACKUP_PING_URL=

# Aylık geri yükleme testinin ping adresi (ayrı monitör); boş = ping yok
RESTORE_PING_URL=
# Geri yükleme testinin kullandığı Postgres imajı (docs/ops/deploy.md)
PG_IMAGE=ghcr.io/<kullanıcı>/mobil-spor-okulu-postgres:17
