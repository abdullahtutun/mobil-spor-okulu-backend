# Kopyalayın: cp .env.example .env  (.env repoya girmez)
# Her anahtar src/config/env.schema.ts'te doğrulanır; eksik/hatalıysa API açılmaz.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# docker compose up -d db ile gelen yerel Postgres. dbmate de bunu okur.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable

# API'nin bağlantısı: api_authenticator rolü (her istekte anon/authenticated/
# service_role'e geçer). Parolası db/compat/00_roles.sql'de verilmez; yerelde
# bir kez: npm run db:api-password  (bu adresteki parolayı role yazar).
API_DATABASE_URL=postgres://api_authenticator:api-yerel-parola@127.0.0.1:5432/postgres?sslmode=disable

# HS256 imza anahtarı, en az 32 karakter. Üretmek: openssl rand -base64 48
JWT_SECRET=yerel-gelistirme-icin-en-az-32-karakterlik-anahtar
# Access token süresi (sn) ve iss claim'i
JWT_EXPIRY_SEC=3600
JWT_ISSUER=mobil-spor-okulu-api

# Auth (S05): dönmüş refresh token'ın kabul süresi (sn) ve giriş sınırları
# (IP başına 5 dk'da deneme; IP+e-posta başına 15 dk'da, e-posta başına
# 1 saatte yanlış şifre)
AUTH_REFRESH_REUSE_INTERVAL_SEC=10
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_FAILURE_LIMIT=10
AUTH_LOGIN_EMAIL_FAILURE_LIMIT=20

# Kodlu akışlar (S06): kod süresi (sn), davet bağlantısı süresi (sn), kod başına
# yanlış deneme; e-posta gönderimi (adres başına aralık sn / saatlik, IP başına
# saatlik) ve kod doğrulama (IP başına 5 dk'da) sınırları
AUTH_OTP_EXPIRY_SEC=600
AUTH_INVITE_EXPIRY_SEC=86400
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_EMAIL_SEND_INTERVAL_SEC=60
AUTH_EMAIL_HOURLY_LIMIT=5
AUTH_EMAIL_IP_HOURLY_LIMIT=30
AUTH_VERIFY_IP_LIMIT=30

# Marka başına SMTP posta kutusu (Hostinger, 465 = SMTPS). Adresler apex alan
# adında (yönetim AGENTS.md → "Sender mailboxes live on apex domains").
# Bir markanınki boşsa o markanın e-postası gitmez ve hata loglanır.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER_DEV_ADIM=
SMTP_PASS_DEV_ADIM=
SMTP_USER_PUBLIC=
SMTP_PASS_PUBLIC=

# S10: oturumsuz formlar. IP özetinin tuzu (Supabase secrets'taki
# IP_HASH_SALT; boşsa JWT_SECRET'tan türetilir), site formunun CORS
# kökenleri (boş = varsayılan üç köken) ve site talebi bildirim adresi
# (boş = e-posta gitmez, talep kaydedilir).
IP_HASH_SALT=
SITE_ALLOWED_ORIGINS=https://mobilsporokulu.com,https://www.mobilsporokulu.com,http://localhost:4321
SITE_LEAD_NOTIFY_TO=

# docker-compose.yml'nin db servisi için (isteğe bağlı)
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432

# Tarayıcıdan çağırabilecek kökenler (virgülle). Boş = CORS kapalı.
CORS_ORIGINS=https://mobil.devadim.com,https://yonetim.mobilsporokulu.com,https://veli.mobilsporokulu.com,http://localhost:8080

# JSON gövde sınırı, IP başına hız sınırı, öndeki vekil sayısı (Coolify: 1)
BODY_LIMIT=1mb
THROTTLE_LIMIT=600
THROTTLE_TTL_MS=60000
TRUST_PROXY=0

# Dosya deposu (S08): baytların diskteki kökü ve dosya başına genel üst sınır
# (bayt; bucket'ın kendi sınırı daha küçükse o geçerli). Kişisel veri içerir.
STORAGE_ROOT=./storage-data
STORAGE_MAX_FILE_SIZE=5242880

# S11 push (ex send-push): Firebase servis hesabı JSON'u tek satır (gerçek
# değer yalnızca .env'de / Coolify'da). Boş = push kapalı, kuyruk bekler.
# API içi kuyruk süpürmesi (ms; 0 = kapalı).
FCM_SERVICE_ACCOUNT=
PUSH_SWEEP_INTERVAL_MS=300000

# S11 realtime (GET /realtime, WebSocket): auth mesajı için süre, ping
# aralığı, oturumun yeniden denetlenmesi (ms), kullanıcı başına bağlantı
REALTIME_AUTH_TIMEOUT_MS=5000
REALTIME_HEARTBEAT_MS=30000
REALTIME_SESSION_CHECK_MS=60000
REALTIME_MAX_SOCKETS_PER_USER=10
